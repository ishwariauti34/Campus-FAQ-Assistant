
/* General Styling */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #667eea, #764ba2);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}


/* Main Container */

.container {
    width: 90%;
    max-width: 750px;
    background: white;
    padding: 30px;
    border-radius: 18px;
    box-shadow: 0 5px 25px rgba(0, 0, 0, 0.2);
}


/* Heading */

h1 {
    text-align: center;
    color: #5b4baf;
    margin-bottom: 10px;
    font-size: 38px;
}

p {
    text-align: center;
    color: #666;
    margin-bottom: 30px;
    font-size: 18px;
}


/* Chat Header */

.chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    color: #5b4baf;
    font-weight: bold;
    font-size: 18px;
}


/* Clear Chat Button */

#clear-btn {
    background: #e8e5ff;
    color: #5b4baf;
    padding: 9px 14px;
    font-size: 13px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

#clear-btn:hover {
    background: #d6d0ff;
}


/* Chat Box */

.chat-box {
    height: 350px;
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 18px;
    overflow-y: auto;
    background: #f8f8fc;
    margin-bottom: 18px;
}


/* Bot Message */

.bot-message {
    background: #e6e3ff;
    color: #333;
    padding: 13px;
    border-radius: 12px;
    margin-bottom: 12px;
    max-width: 85%;
    line-height: 1.5;
}


/* User Message */

.user-message {
    background: #6654c5;
    color: white;
    padding: 13px;
    border-radius: 12px;
    margin: 12px 0 12px auto;
    max-width: 85%;
    line-height: 1.5;
}


/* Sender Names */

.message-sender {
    display: block;
    font-size: 12px;
    margin-bottom: 6px;
    color: #5b4baf;
}

.user-message .message-sender {
    color: #ffffff;
}


/* Message Time */

.message-time {
    display: block;
    font-size: 10px;
    margin-top: 7px;
    text-align: right;
    color: #777;
}

.user-message .message-time {
    color: #eeeaff;
}


/* Suggested Questions */

.suggestions {
    margin-bottom: 18px;
}

.suggestions h3 {
    color: #555;
    font-size: 15px;
    margin-bottom: 10px;
}


/* Suggestion Buttons */

.suggestion-btn {
    background: #eeeaff;
    color: #5b4baf;
    border: 1px solid #d8d0ff;
    padding: 9px 13px;
    border-radius: 20px;
    margin: 4px;
    font-size: 13px;
    cursor: pointer;
    transition: 0.3s;
}

.suggestion-btn:hover {
    background: #6654c5;
    color: white;
}


/* Input Area */

.input-area {
    display: flex;
    gap: 10px;
}

input {
    flex: 1;
    padding: 14px;
    border: 1px solid #ccc;
    border-radius: 9px;
    outline: none;
    font-size: 15px;
}

input:focus {
    border-color: #6654c5;
}


/* Send Button */

button#send-btn {
    padding: 13px 22px;
    background: #6654c5;
    color: white;
    border: none;
    border-radius: 9px;
    cursor: pointer;
    font-size: 15px;
}

button#send-btn:hover {
    background: #4d3aab;
}

button#send-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}


/* Mobile Responsive Design */

@media (max-width: 600px) {

    .container {
        width: 100%;
        padding: 18px;
    }

    h1 {
        font-size: 25px;
    }

    p {
        font-size: 15px;
    }

    .chat-box {
        height: 300px;
    }

    .input-area {
        gap: 6px;
    }

    input {
        min-width: 0;
        font-size: 13px;
    }

    button#send-btn {
        padding: 10px 14px;
    }

    .suggestion-btn {
        font-size: 12px;
    }

    .bot-message,
    .user-message {
        max-width: 95%;
    }

}
